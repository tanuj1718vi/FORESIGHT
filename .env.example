# ==============================================================================
# Project FORESIGHT - Environment Configuration Template
# Copy this file to .env and customize for your local setup.
# ==============================================================================

# Application Environment (development, testing, production)
FORESIGHT_ENV=development

# Logging Configuration (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_TO_FILE=true
LOG_DIR=logs

# Database Configuration
DATABASE_URL=sqlite:///./database/foresight.db

# MLflow Tracking Configuration
MLFLOW_TRACKING_URI=sqlite:///./mlflow.db
MLFLOW_EXPERIMENT_NAME=foresight_demand_forecast

# FastAPI Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
API_WORKERS=1

# Streamlit Dashboard Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# Forecasting Defaults
FORECAST_HORIZON_DAYS=30
HISTORICAL_WINDOW_DAYS=365
DEFAULT_SERVICE_LEVEL=0.95
CONFIDENCE_INTERVAL=0.90
